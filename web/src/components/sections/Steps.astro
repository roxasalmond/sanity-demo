---
const { section } = Astro.props;
const id = `steps-${section._key}`;
---
<section class="wrap section" aria-labelledby={id}>
  <h2 id={id}>{section.heading}</h2>
  <ol class="steps">
    {(section.steps ?? []).map((step) => (
      <li>
        <h3>{step.title}</h3>
        <p>{step.text}</p>
      </li>
    ))}
  </ol>
</section>
